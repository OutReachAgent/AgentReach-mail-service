NODE_ENV=development
PORT=3020

# Internal API authentication. Never commit the real value.
INTERNAL_API_SECRET=replace-with-a-long-random-secret
MAIL_ACCEPT_SUBMISSIONS=false

# Database and queue will be added in the first implementation phase.
DATABASE_URL=mongodb://localhost:27017/reachconvert-mail
REDIS_URL=redis://localhost:6379

# Public hostnames used for outbound and inbound mail.
MAIL_HOSTNAME=mail.example.com
INBOUND_SMTP_HOSTNAME=reply.example.com

# TLS paths for the inbound SMTP process.
SMTP_TLS_KEY_PATH=
SMTP_TLS_CERT_PATH=

