NODE_ENV=development
PORT=3020

# Internal API authentication. Never commit the real value.
INTERNAL_API_SECRET=replace-with-a-long-random-secret
MAIL_ACCEPT_SUBMISSIONS=false

# Outbound SMTP/Postfix transport. For local Mailpit use:
# SMTP_HOST=127.0.0.1, SMTP_PORT=1025, SMTP_SECURE=false.
# For a local Postfix MTA use SMTP_HOST=127.0.0.1, SMTP_PORT=25.
SMTP_HOST=
SMTP_PORT=25
SMTP_HELO_NAME=mail.example.com
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_MAX_ATTEMPTS=3
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Database and queue will be added in the first implementation phase.
DATABASE_URL=mongodb://localhost:27017/reachconvert-mail
REDIS_URL=redis://localhost:6379

# Public hostnames used for outbound and inbound mail.
MAIL_HOSTNAME=mail.example.com
INBOUND_SMTP_HOSTNAME=reply.example.com

# TLS paths for the inbound SMTP process.
SMTP_TLS_KEY_PATH=
SMTP_TLS_CERT_PATH=

